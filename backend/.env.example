# ─────────────────────────────────────────────────────────────────────
# Soraq backend environment — copy to `backend/.env` and fill in.
# NEVER commit `.env`. NEVER put real secrets in this example file.
# Real environment variables (server config) take precedence over this file.
# ─────────────────────────────────────────────────────────────────────

# development | staging | production
APP_ENV=development
# Must be false in staging/production (forced off when APP_ENV=production).
APP_DEBUG=true
# Public URL of the frontend (used to derive allowed origins).
APP_URL=http://localhost:5173
# Default language of API messages (must exist in backend/lang/). Clients may request another via Accept-Language.
APP_LOCALE=es
# Comma-separated list of origins allowed to send state-changing requests.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database (MySQL / MariaDB) ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soraq_local
DB_USERNAME=soraq_local
DB_PASSWORD=change-me

# ─── Session ──────────────────────────────────────────────────────────
# Seconds without activity before the session expires (8h).
SESSION_IDLE_TIMEOUT=28800
# Maximum session lifetime regardless of activity (7 days).
SESSION_ABSOLUTE_TIMEOUT=604800
# true in any HTTPS environment (staging/production). Enables the __Host- cookie prefix.
SESSION_SECURE_COOKIE=false

# ─── Limits ───────────────────────────────────────────────────────────
# Maximum accepted JSON request body in bytes (1 MB).
HTTP_MAX_BODY_BYTES=1048576

# ─── AI (docs/decisions/0013) ─────────────────────────────────────────
# Provider for fast summaries (Context Prompt). Only "groq" is supported today.
AI_PROVIDER=groq
# Secret key from https://console.groq.com/keys — set it ONLY in backend/.env or the server environment.
GROQ_API_KEY=
# Model used for summaries (any Groq chat model).
GROQ_MODEL=llama-3.3-70b-versatile
# Seconds before an AI request is abandoned.
AI_TIMEOUT_SECONDS=30
# Maximum characters of note content sent per summary request.
AI_MAX_INPUT_CHARS=24000
