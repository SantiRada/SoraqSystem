# ─────────────────────────────────────────────────────────────────────
# Soraq frontend environment — copy to `frontend/.env.local`.
#
# ⚠ Every VITE_* variable is embedded in the public JavaScript bundle.
#   NEVER put secrets, API keys or credentials in a VITE_* variable.
#   Secrets belong in backend/.env only.
# ─────────────────────────────────────────────────────────────────────

# Public canonical URL of the site (SEO: canonical, Open Graph).
VITE_SITE_URL=https://soraq.app

# Base path of the API as seen by the browser. Same-origin in every environment.
VITE_API_BASE_URL=/api

# Dev-only (NOT exposed to the browser): where Vite proxies /api during `npm run dev`.
SORAQ_DEV_API_TARGET=http://localhost/SoraqSystem/backend/public
